# Copy to .env and fill values. This file is safe to commit.
PORT=3000
# Use your Atlas non-SRV URI or local Mongo
# Example (Atlas non-SRV): mongodb://<user>:<password>@host1:27017,host2:27017,host3:27017/ai_honeypot?tls=true&replicaSet=<rs>&authSource=admin&retryWrites=true&w=majority
# Example (local): mongodb://127.0.0.1:27017/ai_honeypot
MONGO_URI=

# Gemini API key (do NOT commit real key in .env)
GEMINI_API_KEY=
